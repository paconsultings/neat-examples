FROM scratch AS neat-runtime

ARG NEAT_RUNTIME_VERSION=unknown
ARG APPS_REFERENCE_REV=f8fd5830c2c228560ccb94b3d0fa009ac53fb128
LABEL org.opencontainers.image.description="YOLO26 app with bundled Neat user-space runtime" \
      org.opencontainers.image.source="https://github.com/sima-neat/apps" \
      org.opencontainers.image.revision="${APPS_REFERENCE_REV}" \
      ai.sima.neat.runtime-version="${NEAT_RUNTIME_VERSION}"

COPY build/bundled-runtime/rootfs/ /app/runtime/rootfs/
COPY build/bundled-runtime/python/ /app/runtime/python/
COPY run-bundled-app.sh /app/run-bundled-app.sh

ENV LD_LIBRARY_PATH=/app/runtime/rootfs/usr/lib:/app/runtime/rootfs/usr/lib/aarch64-linux-gnu:/app/runtime/rootfs/usr/lib/aarch64-linux-gnu/neat/runtime:/app/runtime/rootfs/usr/lib/aarch64-linux-gnu/neat/gst-plugins \
    GST_PLUGIN_PATH=/app/runtime/rootfs/usr/lib/aarch64-linux-gnu/neat/gst-plugins \
    GST_PLUGIN_PATH_1_0=/app/runtime/rootfs/usr/lib/aarch64-linux-gnu/neat/gst-plugins \
    SIMA_NEAT_LIBRARY_PATH=/app/runtime/rootfs/usr/lib/aarch64-linux-gnu/neat/runtime:/app/runtime/rootfs/usr/lib/aarch64-linux-gnu/neat/gst-plugins \
    PYTHONPATH=/app/runtime/python

FROM neat-runtime AS python
LABEL org.opencontainers.image.title="Neat YOLO26 Python container with bundled Neat runtime"
COPY main.py /app/main.py
ENTRYPOINT ["/bin/sh", "/app/run-bundled-app.sh", "python"]

FROM neat-runtime AS cpp
LABEL org.opencontainers.image.title="Neat YOLO26 C++ container with bundled Neat runtime"
COPY build/cmake/yolo26-benchmark /app/yolo26-benchmark
ENTRYPOINT ["/bin/sh", "/app/run-bundled-app.sh", "cpp"]
